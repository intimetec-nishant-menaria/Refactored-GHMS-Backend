<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\guest_house_management_backend.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Development" />
          
          <environmentVariable name="ConnectionStrings__Default" value="Host=127.0.0.1;Port=5432;Database=GuestHouseDb-Refactored;Username=postgres;Password=7070" />
          <environmentVariable name="ConnectionStrings__Valkey" value="192.168.32.214:6379,abortConnect=false,connectTimeout=10000,protocol=resp2" />

          <environmentVariable name="JWT__AccessSecret" value="ThisIsMyAccessSecretJWTKeyWritingSomeRandomText" />
          <environmentVariable name="JWT__RefreshSecret" value="ThisIsMyRefreshSecretJWTKeyWritingSomeRandomText" />
          <environmentVariable name="JWT__ValidIssuer" value="https://172.16.0.97:7188" />
          <environmentVariable name="JWT__ValidAudience" value="User" />

          <environmentVariable name="EmailSettings__SenderEmail" value="guesthousemanagement983@gmail.com" />
          <environmentVariable name="EmailSettings__Password" value="yygrbxcgfyiuovlp" />
          <environmentVariable name="EmailSettings__SmtpServer" value="smtp.gmail.com" />
          <environmentVariable name="EmailSettings__Port" value="587" />

          <environmentVariable name="Frontend__URL" value="172.16.0.97:5173" />
        </environmentVariables>
      </aspNetCore>

      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="104857600" /> </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>